      "id": "spiegazione",
      "slides": [
        {
          "text": "Un accordo si può anche **spezzare**: basso, quinta, terza, quinta. È il **basso albertino**, usato anche da Mozart!",
          "showStaff": "bass",
          "animation": {
            "kind": "staff-note",
            "params": {
              "notes": [
                "C3",
                "G3",
                "E3",
                "G3"
              ]
            }
          }
        },
        {
          "text": "La sinistra accompagna, la destra canta la melodia. Ascolta prima, poi prova le mani separate.",
          "animation": {
            "kind": "rhythm-pulse",
            "params": {
              "pattern": [
                1,
                1,
                1,
                1
              ],
              "bpm": 72
