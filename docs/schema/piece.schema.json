{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "composer": {
      "type": "string"
    },
    "arranger": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "enum": [
        "public-domain",
        "original"
      ],
      "description": "obbligatorio: solo brani liberi o originali"
    },
    "tempo": {
      "type": "object",
      "properties": {
        "bpm": {
          "type": "number",
          "minimum": 20,
          "maximum": 300
        }
      },
      "required": [
        "bpm"
      ]
    },
    "timeSignature": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "key": {
      "type": "object",
      "properties": {
        "fifths": {
          "type": "integer",
          "minimum": -7,
          "maximum": 7
        },
        "mode": {
          "type": "string",
          "enum": [
            "major",
            "minor"
          ]
        }
      },
      "required": [
        "fifths",
        "mode"
      ]
    },
    "pickupBeats": {
      "type": "number",
      "minimum": 0
    },
    "staves": {
      "minItems": 1,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "treble",
          "bass"
        ]
      }
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0,
            "description": "inizio in beat dall’inizio del brano"
          },
          "d": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "durata in beat (1 = semiminima)"
          },
          "p": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "altezze: [] = pausa, più elementi = accordo"
          },
          "hand": {
            "type": "string",
            "enum": [
              "R",
              "L"
            ]
          },
          "staff": {
            "description": "default: R → treble, L → bass",
            "type": "string",
            "enum": [
              "treble",
              "bass"
            ]
          },
          "fingers": {
            "description": "diteggiatura, allineata a p",
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                },
                {
                  "type": "number",
                  "const": 4
                },
                {
                  "type": "number",
                  "const": 5
                }
              ]
            }
          },
          "tie": {
            "description": "legatura di valore con la nota successiva",
            "type": "boolean"
          },
          "label": {
            "description": "testo/sillaba mostrata sotto la nota",
            "type": "string"
          }
        },
        "required": [
          "t",
          "d",
          "p",
          "hand"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "license",
    "tempo",
    "timeSignature",
    "key",
    "staves",
    "events"
  ]
}
