{
  "name": "pianotutor",
  "version": "0.6.0",
  "description": "Piano Tutor - impara il pianoforte da zero (PWA)",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run validate && tsc -p . --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "icons": "pwa-assets-generator",
    "schema": "tsx tools/gen-json-schema.ts",
    "test:e2e": "playwright test",
    "validate": "tsx tools/validate-content.ts",
    "fixtures": "tsx tools/gen-mic-fixture.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rabax1972/PianoTutor.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rabax1972/PianoTutor/issues"
  },
  "homepage": "https://github.com/rabax1972/PianoTutor#readme",
  "dependencies": {
    "dexie": "^4.4.7",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vexflow": "^5.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true
}
